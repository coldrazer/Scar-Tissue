# Copy to .env and fill in what you use. Everything is optional for --mock runs.

# Which model writes code, and which one distills lessons from failures.
# meta | gemini | subq | openai | mock
SCAR_PROVIDER=meta
SCAR_DISTILL_PROVIDER=meta
# Override the default model names (list them with: python scar.py models --provider meta)
# SCAR_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# SCAR_DISTILL_MODEL=

# Meta Llama API (OpenAI-compatible endpoint https://api.llama.com/compat/v1)
LLAMA_API_KEY=

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Subquadratic SubQ (OpenAI-compatible; base URL and model from your early-access dashboard)
SUBQ_BASE_URL=
SUBQ_API_KEY=
SUBQ_MODEL=

# Any other OpenAI-compatible server
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Sandbox backend: subprocess (default, hardened) | container (production:
# docker/podman per run, no network) | auto. Image for container runs:
SCAR_SANDBOX=subprocess
# SCAR_SANDBOX_IMAGE=python:3.12-slim

# API keys + tenancy. Format: tenant:key,other:key -- when set, /api/* needs
# the key and each tenant gets an isolated lesson store.
SCAR_API_KEYS=
SCAR_TENANT=default

# Cost ledger + hard budget. Prices in $ per 1M tokens; run stops at the cap.
# SCAR_PRICE_IN_PER_MTOK=0.50
# SCAR_PRICE_OUT_PER_MTOK=1.50
# SCAR_MAX_COST_USD=5.00

# MongoDB / Atlas. When set, lessons, epochs and events live here instead of runs/state.json.
MONGODB_URI=
MONGODB_DB=scar_tissue

# Fetch.ai agent (agents/fetch_agent.py). The seed IS the agent identity:
# there is no default. Generate a private one, never commit it:
#   python -c "import secrets; print(secrets.token_hex(16))"
SCAR_AGENT_PORT=8001
SCAR_MAILBOX=0
SCAR_AGENT_SEED=
# Optional shared token: when set, lesson queries must send the same token.
SCAR_AGENT_TOKEN=
